#!/bin/sh
# theia-swp — a Mender Update Module that installs a user SOFTWARE PACKAGE (SWP) as
# a whole RELEASE and atomically FLIPS current → it (the day-2/3 app plane).
#
# Two-plane OTA (docs/design/two-plane-ota.md). Exactly ONE active release at a
# time; a rollout is an atomic current-flip; rollback is the reverse. The runtime
# and the SWP are independent planes that meet only on this file layout:
#
#   theia-release  the RUNTIME as a release: releases/runtime-<ver>/{bin,config}.
#                  Colony/deb lays it + current → it (the resting state).
#   theia-swp      an SWP as a release: releases/<swp>-<ver>/{bin,config}, built by
#                  copying the CURRENT release's services bin + overlaying the SWP's
#                  FC bin, and using the SWP's OWN executor.json (services + FCs) as
#                  the release config. Then flip current → it. The supervisor reads
#                  current/config/executor.json (via theia-run). bin/supervisor
#                  stays flat — the release carries only the CHILDREN.
#
# Why a full release (not a merge): the SWP already ships a complete
# manifest/<machine>/executor.json (services baseline + its FC nodes), so we make
# it a real release dir and flip — no in-place mutation of a shared config, no
# accumulation of two SWPs' procs, rollback is one symlink flip. (The prior model
# merged the SWP's app group into a shared /opt/theia/config/executor.json, which
# left multiple SWPs' procs co-resident — see the design doc's problem statement.)
#
# Artifact payload (produced by `theia release-swp`):
#   <app>-<ver>.tar.gz   tar of { bin/<fc>, manifest/machines.json,
#                                 manifest/<machine>/{machine,executor,application}.json,
#                                 version.txt, requires_runtime.txt, [migration/],
#                                 app.json, [health] }
#   version.txt          <app>-<ver>-<abi>  (the artifact-name gate + release dir name)
#   app.json             {"processes": [{"name": <proc>, "exe": <bin/ basename>}, …], …}
#                        — the processes this SWP ADDS; the commit gate checks each
#                        (see _app_gate). Laid into releases/<ver>/app.json.
#   health               OPTIONAL executable app-level check (see _run_health_hook),
#                        laid into releases/<ver>/health.
#
# Hardening (the payload is untrusted input to a root script):
#   * version.txt must be ONE safe path component (see _valid_name) and must not
#     name the currently running release — both are refused in ArtifactInstall.
#   * the tarball is listed first and refused if it has an absolute path, a '..'
#     component, or any symlink/hardlink/device member; it is extracted with
#     --no-same-owner --no-same-permissions.
#   * ArtifactCommit is a HEALTH GATE (see _health_gate): a stable supervisor, then
#     every process app.json declares running FROM the new release with one pid
#     for THEIA_OTA_APP_STABLE_S (10) seconds, all within THEIA_OTA_HEALTH_WAIT_S
#     (60) seconds, then the optional `health` hook → else exit 1 → Mender rolls
#     back. ArtifactRollback with no `previous` exits non-zero.
#   * app.json process names / exe basenames must pass _valid_name (refused at
#     ArtifactInstall).
#
# Mender invokes:  theia-swp <STATE> <payload-files-dir>
set -eu

STATE="$1"
FILES="${2:-}"

THEIA_ROOT="${THEIA_ROOT:-/opt/theia}"
RELEASES="$THEIA_ROOT/releases"
CURRENT="$THEIA_ROOT/current"
PREVIOUS="$THEIA_ROOT/previous"
MACHINE="${THEIA_MACHINE:-master}"       # the role whose executor slice to activate

MOD=theia-swp

# ---- hardening: untrusted-input validation -----------------------------------
# (The SAME block lives in theia-swp / theia-app / theia-release — the modules are
# dependency-free /bin/sh scripts, so the helpers are copied, not sourced. Keep
# the three copies identical; platform/runtime/ota/test/test_modules.sh checks it.)
#
# Everything in the payload (version.txt, app.json, the tarball) is UNTRUSTED
# input to a root script.
#
# _valid_name: a release / app name becomes ONE path component under $THEIA_ROOT
# (releases/<name>, apps/<name>), so it must match
#     ^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$
# — no '/', never '.' or '..', no whitespace/newline, at most 64 characters.
_valid_name() (
    LC_ALL=C
    [ "${#1}" -le 64 ] || exit 1
    case "$1" in
      ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._+-]*) exit 1 ;;
    esac
    exit 0
)
_require_name() {   # $1 = what it is (for the message), $2 = the value
    _valid_name "$2" && return 0
    echo "$MOD: REFUSED — invalid $1 (must match ^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}\$)" >&2
    return 1
}
# _is_current: does releases/<name> resolve to the tree `current` points at? A
# re-install of the RUNNING release would overwrite/delete the live tree, so the
# callers refuse it (roll forward to a new version, or roll back, instead).
_is_current() {
    [ -e "$CURRENT" ] || return 1
    _cur="$(readlink -f "$CURRENT" 2>/dev/null || true)"
    _new="$(readlink -f "$THEIA_ROOT/releases/$1" 2>/dev/null || true)"
    [ -n "$_cur" ] && [ "$_cur" = "$_new" ]
}
# _tar <tarball> <tar-args…>: run tar over a (possibly zstd) payload tarball.
_tar() {
    _tb="$1"; shift
    case "$_tb" in
      *.zst) zstd -dc "$_tb" | tar "$@" -f - ;;
      *)     tar "$@" -f "$_tb" ;;
    esac
}
# _tar_check: list the archive BEFORE extracting and refuse it unless every
# member is a plain file or directory with a relative, '..'-free name: no
# absolute paths, no '..' components, no symlinks / hardlinks / devices / fifos.
_tar_check() {
    _names="$(_tar "$1" -t 2>/dev/null)" || {
        echo "$MOD: REFUSED — unreadable archive $(basename "$1")" >&2; return 1; }
    _listing="$(_tar "$1" -tv 2>/dev/null)" || {
        echo "$MOD: REFUSED — unreadable archive $(basename "$1")" >&2; return 1; }
    [ -n "$_listing" ] || return 0
    if printf '%s\n' "$_names" | LC_ALL=C grep -Eq '^/|(^|/)\.\.(/|$)'; then
        echo "$MOD: REFUSED — archive has an absolute path or a '..' member" >&2
        return 1
    fi
    if printf '%s\n' "$_listing" | LC_ALL=C grep -qv '^[-d]'; then
        echo "$MOD: REFUSED — archive has a symlink/hardlink/device member (only plain files + dirs allowed)" >&2
        return 1
    fi
    return 0
}
# _tar_extract <tarball> <dest>: checked extraction. Ownership and mode bits come
# from this process (umask), never from the archive.
_tar_extract() {
    _tar_check "$1" || return 1
    _tar "$1" -x --no-same-owner --no-same-permissions -C "$2"
}
# ---- end hardening block ------------------------------------------------------

_payload() {   # echo the path to a payload file, files/ or bare
    if [ -f "$FILES/files/$1" ]; then echo "$FILES/files/$1";
    elif [ -f "$FILES/$1" ]; then echo "$FILES/$1"; fi
}

_artifact_name() {
    vt="$(_payload version.txt)"
    [ -n "$vt" ] && cat "$vt" || echo "unknown"
}

# The <machine> subdir inside the SWP tar whose executor.json we activate. Prefer
# $THEIA_MACHINE (the board's role) if the SWP ships a slice for it — a
# multi-machine SWP applies the CORRECT slice per board; fall back to the sole one.
_swp_machine_dir() {   # $1 = untarred SWP staging dir; echoes manifest/<machine>
    stg="$1"
    if [ -d "$stg/manifest/$MACHINE" ]; then echo "manifest/$MACHINE"; return; fi
    d="$(ls -d "$stg"/manifest/*/ 2>/dev/null | head -1 || true)"
    [ -n "$d" ] && echo "manifest/$(basename "$d")"
}

# ---- runtime-dependency gate (preserved from the merge model) ----------------
# The installed theia-runtime deb version (M.m.p), or "" if not provisioned.
_installed_runtime() {
    dpkg-query -W -f='${Version}' theia-runtime 2>/dev/null || true
}
# Does the installed runtime satisfy the SWP's requires_runtime? major.minor must
# match; patch is tolerated. Empty pin = unpinned → always satisfied.
_runtime_satisfies() {
    pin="$1"; got="$2"
    [ -n "$pin" ] || return 0
    [ -n "$got" ] || return 1
    pin_mm="$(echo "$pin" | sed 's/-[a-z0-9._-]*$//' | cut -d. -f1,2)"
    got_mm="$(echo "$got" | sed 's/^[0-9]*://; s/-.*$//' | cut -d. -f1,2)"
    [ "$pin_mm" = "$got_mm" ]
}
# Gate the SWP install on the runtime (GS fans runtime→colony + app→Mender in
# parallel, so the SWP can arrive before its runtime deb). WAIT until satisfied.
_require_runtime() {
    pin="$1"
    got="$(_installed_runtime)"
    if _runtime_satisfies "$pin" "$got"; then
        echo "theia-swp: runtime dependency satisfied (requires '$pin', installed '$got')"
        return 0
    fi
    T="${THEIA_SWP_RUNTIME_WAIT_S:-3600}"
    echo "theia-swp: runtime not ready (requires '$pin', installed '${got:-none}') — SWP PENDING, re-checking every 10s (up to ${T}s; cancel in the GS to abort)"
    waited=0
    while [ "$waited" -lt "$T" ]; do
        sleep 10; waited=$((waited + 10))
        got="$(_installed_runtime)"
        if _runtime_satisfies "$pin" "$got"; then
            echo "theia-swp: runtime now satisfied (installed '$got') after ${waited}s — proceeding"
            return 0
        fi
    done
    echo "theia-swp: runtime dependency '$pin' not satisfied within ${T}s (installed '${got:-none}') — failing install" >&2
    return 1
}

# ---- major migration hook (preserved) ----------------------------------------
# A MAJOR SWP ships migration/{migration.json, plugins} and runs theia-migrate
# forward BEFORE the flip (against the still-current release, so per holds the
# pre-upgrade config). A non-zero exit aborts the install (Mender rolls back). No
# migration/ dir → free-swap no-op.
_run_migration() {
    work="$1"
    [ -f "$work/migration/migration.json" ] || {
        echo "theia-swp: no config migration (free-swap SWP)"; return 0; }
    tm="$THEIA_ROOT/bin/theia-migrate"
    [ -x "$tm" ] || { echo "theia-swp: $tm missing (runtime too old for config migration)" >&2; return 1; }
    echo "theia-swp: running config migration (theia-migrate forward)"
    if "$tm" forward "$work/migration"; then
        echo "theia-swp: config migration OK"; return 0
    else
        echo "theia-swp: config migration FAILED — aborting install" >&2; return 1
    fi
}

# ---- lazy-resource (model) pull hook -----------------------------------------
# An SWP that declares `model:` resources ships manifest/models.json (release-swp
# collects them). AFTER the flip — so the models land in the just-activated
# release before the supervisor restart spawns the FCs — pull them from the S3
# model plane into $CURRENT/share/<fc>/data (theia::runtime::share_dir reads there).
#
# The S3 ENDPOINT + bucket + fleet ride IN the descriptor's `s3` block (stamped by
# release-swp), delivered over Mender's own authenticated channel — so `theia
# models pull` needs no separately-provisioned endpoint (no Ansible, no
# mender.conf change). The MinIO key/secret are NON-secret plane defaults
# (MINIO_USER/MINIO_PASSWORD, applied by `theia models pull`), never in the
# artifact. No models.json → no-op. A failed pull does NOT abort the install: the
# code is in place; a missing model is a data problem to surface, not a reason to
# roll back a good release.
_pull_models() {
    work="$1"
    desc="$work/manifest/models.json"
    [ -f "$desc" ] || { echo "theia-swp: no lazy models (no models.json)"; return 0; }
    tcli="$THEIA_ROOT/bin/theia"
    [ -x "$tcli" ] || { echo "theia-swp: $tcli missing — cannot pull models" >&2; return 0; }
    echo "theia-swp: pulling lazy models (models.json) into current/share"
    if THEIA_SHARE_DIR="$CURRENT/share" "$tcli" models pull --descriptor "$desc"; then
        echo "theia-swp: models pulled OK"
    else
        echo "theia-swp: WARNING — models pull failed (models absent on device); " \
             "install continues" >&2
    fi
    return 0
}

# ---- supervisor restart (preserved; adopts the flipped current/config) -------
# The supervisor reads executor.json once at startup (static tree, no hot-reload),
# so "adopt the flip" = RESTART it: it re-reads current/config/executor.json (now
# the SWP's) and spawns the SWP's tree. systemd path preferred; container fallback.
_reload_supervisor() {
    if [ -x "$THEIA_ROOT/bin/tdb" ] && "$THEIA_ROOT/bin/tdb" reload 2>/dev/null; then
        echo "theia-swp: supervisor reloaded (tdb)"; return 0
    fi
    if command -v systemctl >/dev/null 2>&1 && systemctl cat theia-supervisor >/dev/null 2>&1; then
        systemctl restart theia-supervisor 2>/dev/null \
            && { echo "theia-swp: supervisor restarted (systemd) — adopting current/config"; return 0; }
    fi
    launcher="$THEIA_ROOT/bin/theia-run"
    me=$$
    for pid in $(pgrep -x supervisor 2>/dev/null); do
        [ "$pid" = "$me" ] && continue
        kill -TERM "$pid" 2>/dev/null || true
    done
    i=0; while [ $i -lt 16 ] && pgrep -x supervisor >/dev/null 2>&1; do sleep 0.5; i=$((i+1)); done
    if [ -x "$launcher" ]; then
        ( THEIA_ROOT_DIR="$THEIA_ROOT" setsid "$launcher" >/var/log/theia-supervisor.log 2>&1 < /dev/null & )
        sleep 3
        pgrep -x supervisor >/dev/null 2>&1 \
            && echo "theia-swp: supervisor relaunched via theia-run — adopting current/config" \
            || echo "theia-swp: supervisor relaunch did not come up — check /var/log/theia-supervisor.log" >&2
    else
        echo "theia-swp: no launcher to relaunch (runtime not provisioned?) — adopts on next start" >&2
    fi
}

# ---- commit health gate --------------------------------------------------------
# ArtifactCommit restarts the supervisor onto the flipped release; the commit only
# STANDS if the supervisor AND the SWP's own processes then come up and stay up.
# The signals need no python/tdb/TIPC (sh, ls, sed, awk, coreutils `timeout`):
#
#  1. SUPERVISOR: a process named `supervisor` whose executable is
#     $THEIA_ROOT/bin/supervisor (the binary theia-run execs) is running,
#     `current/config/executor.json` (the manifest it was started on) exists, and
#     the SAME pid is seen on THEIA_OTA_HEALTH_STABLE (default 3) consecutive
#     probes one second apart.
#  2. APP PROCESSES (_app_gate): every process current/app.json declares is
#     running FROM the flipped release — /proc/<pid>/exe is exactly
#     <release>/bin/<exe> (not a deleted file, not the previous release's binary) —
#     and its pid stays the same for THEIA_OTA_APP_STABLE_S (default 10)
#     consecutive seconds. A node that crashes or restart-loops under a healthy
#     supervisor never holds a pid that long.
#  3. HOOK (_run_health_hook): if the release carries an executable `health`, it
#     must exit 0.
#
# 1 and 2 share ONE budget: THEIA_OTA_HEALTH_WAIT_S seconds (default 60) from the
# start of the gate; the hook has its own timeout. Any failure → a log line naming
# the process (MISSING / RESTARTING / OLD BINARY / NOT STABLE / hook exit N) →
# non-zero exit → Mender runs ArtifactRollback (current → previous + restart, so
# the previous app version runs again). An SWP with no app.json processes keeps
# the supervisor-only gate, with a WARNING. THEIA_OTA_HEALTH_WAIT_S=0 DISABLES the
# whole gate (lab rigs whose supervisor is not started from $THEIA_ROOT/bin);
# never set it on a fleet rig.
#
# TIMINGS: an SWP may set its own in app.json `gate` (a node that loads a model
# needs longer than 60 s): {"wait_s": W, "stable_s": S, "hook_timeout_s": H}.
# Precedence: env (THEIA_OTA_HEALTH_WAIT_S / THEIA_OTA_APP_STABLE_S /
# THEIA_OTA_HOOK_TIMEOUT_S, lab use, NOT capped) > the SWP's `gate` (capped on the
# rig: wait_s <= 300, stable_s <= 60, hook_timeout_s <= 60; a larger value is
# clamped with a log line) > the defaults 60 / 10 / 10.
#
# HOOK CONTRACT (releases/<ver>/health, optional): run as user `theia` when the
# module is root (refused if there is no such user), cwd = the release dir, stdin
# /dev/null, env THEIA_ROOT, THEIA_RELEASE (the release dir), THEIA_ARTIFACT
# (version.txt) and LD_LIBRARY_PATH=<release>/lib (the SWP's own libs), killed
# after hook_timeout_s (default 10). Exit 0 = healthy; anything else (or the
# timeout) fails the commit. The LAST line of its stdout goes into the gate log;
# its stderr goes to the deployment log.
_GATE_CAP_WAIT=300; _GATE_CAP_STABLE=60; _GATE_CAP_HOOK=60

# _swp_processes <app.json>: print "<name> <exe>" per declared process. The file
# is parsed without a JSON tool: release-swp writes `processes` as an array of
# flat {"name": …, "exe": …} objects (exe defaults to name). Every name/exe must
# pass _valid_name — else a message and exit 1.
_swp_processes() (
    [ -f "$1" ] || exit 0
    tr '\n\r\t' '   ' < "$1" \
      | sed -n 's/.*"processes"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p' \
      | tr '}' '\n' \
      | while IFS= read -r obj; do
            n="$(printf '%s\n' "$obj" | sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
            e="$(printf '%s\n' "$obj" | sed -n 's/.*"exe"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
            [ -n "$n" ] || continue
            [ -n "$e" ] || e="$n"
            _require_name "app.json process name" "$n" || exit 1
            _require_name "app.json process exe" "$e" || exit 1
            echo "$n $e"
        done
)
# _swp_gate_value <app.json> <key>: the integer `gate.<key>` of app.json, or "".
_swp_gate_value() {
    [ -f "$1" ] || return 0
    tr '\n\r\t' '   ' < "$1" \
      | sed -n 's/.*"gate"[[:space:]]*:[[:space:]]*{\([^}]*\)}.*/\1/p' \
      | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\\([0-9][0-9]*\\).*/\\1/p"
}
# _gate_timing <env value> <app.json> <key> <default> <cap>: echo the effective
# seconds (env > SWP gate value clamped to cap > default); logs where it came from.
_gate_timing() {
    _ev="$1"; _key="$3"; _def="$4"; _cap="$5"
    case "$_ev" in ''|*[!0-9]*) ;; *) echo "$_ev"; return 0 ;; esac
    _sv="$(_swp_gate_value "$2" "$_key")"
    case "$_sv" in ''|*[!0-9]*) echo "$_def"; return 0 ;; esac
    if [ "$_sv" -gt "$_cap" ]; then
        echo "theia-swp: gate.$_key=$_sv from app.json CLAMPED to the rig cap $_cap" >&2
        _sv="$_cap"
    else
        echo "theia-swp: gate.$_key=$_sv from app.json" >&2
    fi
    echo "$_sv"
}
# _proc_table: "<pid> <exe target>" for every process whose /proc/<pid>/exe is
# readable (all of them as root). One ls + one sed per probe.
_proc_table() {
    LC_ALL=C ls -l /proc/[0-9]*/exe 2>/dev/null \
      | sed -n 's|^.* /proc/\([0-9][0-9]*\)/exe -> \(..*\)$|\1 \2|p'
}
# _app_gate <release dir> <"name exe" lines> <t0> <wait_s> <stable_s>: probe once
# a second until every declared process holds one pid running <release>/bin/<exe>
# for stable_s seconds (→ 0) or the clock (started at t0) passes wait_s (→ 1, one
# COMMIT FAILED line per failing process).
_app_gate() {
    rel="$1"; plist="$2"; t="$3"; wait_s="$4"; stable_s="$5"
    n=0
    while read -r _pn _pe; do
        [ -n "$_pn" ] || continue
        n=$((n + 1))
        eval "pn_$n=\$_pn; pe_$n=\$_pe; sig_$n=''; since_$n=0; chg_$n=0; seen_$n=0; old_$n=''"
    done <<EOF
$plist
EOF
    while :; do
        tbl="$(_proc_table)"
        good=0; i=1
        while [ "$i" -le "$n" ]; do
            eval "e=\$pe_$i; last=\$sig_$i"
            want="$rel/bin/$e"
            sig="$(printf '%s\n' "$tbl" | awk -v w="$want" \
                '{ p = $1; sub(/^[0-9]+ /, ""); if ($0 == w) print p }' | sort -n | tr '\n' ' ')"
            sig="${sig% }"
            old="$(printf '%s\n' "$tbl" | awk -v w="$want" -v b="/$e" \
                '{ p = $1; sub(/^[0-9]+ /, ""); x = $0; sub(/ \(deleted\)$/, "", x);
                   if ($0 != w && substr(x, length(x) - length(b) + 1) == b) { print p " " $0; exit } }')"
            if [ "$sig" != "$last" ]; then
                eval "since_$i=\$t"
                [ -n "$last" ] && eval "chg_$i=\$((chg_$i + 1))"
            fi
            [ -n "$sig" ] && eval "seen_$i=1"
            eval "sig_$i=\$sig; old_$i=\$old; since=\$since_$i"
            if [ -n "$sig" ] && [ $((t - since)) -ge "$stable_s" ]; then good=$((good + 1)); fi
            i=$((i + 1))
        done
        if [ "$good" -eq "$n" ]; then
            i=1
            while [ "$i" -le "$n" ]; do
                eval "echo \"theia-swp: app process '\$pn_$i' OK — pid \$sig_$i runs $rel/bin/\$pe_$i, stable \$((t - since_$i))s\""
                i=$((i + 1))
            done
            return 0
        fi
        [ "$t" -lt "$wait_s" ] || break
        sleep 1; t=$((t + 1))
    done
    i=1
    while [ "$i" -le "$n" ]; do
        eval "pn=\$pn_$i; e=\$pe_$i; sig=\$sig_$i; since=\$since_$i; chg=\$chg_$i; seen=\$seen_$i; old=\$old_$i"
        up=$((t - since)); want="$rel/bin/$e"
        why=""
        if [ -n "$sig" ] && [ "$up" -ge "$stable_s" ]; then :
        elif [ -n "$sig" ] && [ "$chg" -gt 0 ]; then
            why="RESTARTING — pid changed $chg time(s), now $sig up ${up}s (needs ${stable_s}s)"
        elif [ -n "$sig" ]; then
            why="NOT STABLE — pid $sig up only ${up}s (needs ${stable_s}s)"
        elif [ -n "$old" ]; then
            why="OLD BINARY — pid ${old%% *} runs ${old#* }, not $want"
        elif [ "$seen" = 1 ]; then
            why="RESTARTING — exited after start ($chg pid change(s)), not running now"
        else
            why="MISSING — no process runs $want"
        fi
        [ -n "$why" ] && echo "theia-swp: COMMIT FAILED — app process '$pn' $why (gate ${wait_s}s) — Mender will roll back" >&2
        i=$((i + 1))
    done
    return 1
}
# _run_health_hook <release dir> <timeout s>: the optional per-SWP check (contract
# above). 0 = healthy or no hook.
_run_health_hook() {
    rel="$1"; hs="$2"; hook="$rel/health"
    [ -e "$hook" ] || return 0
    if [ ! -f "$hook" ] || [ ! -x "$hook" ]; then
        echo "theia-swp: COMMIT FAILED — health hook $hook is not an executable file — Mender will roll back" >&2
        return 1
    fi
    command -v timeout >/dev/null 2>&1 || {
        echo "theia-swp: COMMIT FAILED — health hook present but no timeout(1) on the rig — Mender will roll back" >&2
        return 1; }
    set --
    if [ "$(id -u)" = 0 ]; then
        if ! getent passwd theia >/dev/null 2>&1; then
            echo "theia-swp: COMMIT FAILED — health hook present but no user 'theia' to run it as — Mender will roll back" >&2
            return 1
        fi
        if command -v runuser >/dev/null 2>&1; then set -- runuser -u theia --
        else set -- setpriv --reuid=theia --regid=theia --init-groups --; fi
    fi
    art="$(cat "$rel/.mender_version" 2>/dev/null || true)"
    echo "theia-swp: running health hook $hook (as $([ $# -gt 0 ] && echo theia || id -un), timeout ${hs}s)"
    hrc=0
    hout="$(cd "$rel" && "$@" env THEIA_ROOT="$THEIA_ROOT" THEIA_RELEASE="$rel" \
             THEIA_ARTIFACT="$art" LD_LIBRARY_PATH="$rel/lib" \
             timeout -k 2 "$hs" ./health </dev/null)" || hrc=$?
    hlast="$(printf '%s\n' "$hout" | tail -n 1 | cut -c1-240)"
    echo "theia-swp: health hook said: ${hlast:-<no output>}"
    case "$hrc" in
      0)       echo "theia-swp: health hook OK (exit 0)"; return 0 ;;
      124|137) echo "theia-swp: COMMIT FAILED — health hook TIMED OUT after ${hs}s — Mender will roll back" >&2 ;;
      *)       echo "theia-swp: COMMIT FAILED — health hook exit $hrc — Mender will roll back" >&2 ;;
    esac
    return 1
}
_supervisor_pid() {   # echo the pid of OUR supervisor ($THEIA_ROOT/bin/supervisor)
    want="$(readlink -f "$THEIA_ROOT/bin/supervisor" 2>/dev/null || true)"
    [ -n "$want" ] || return 1
    for pid in $(pgrep -x supervisor 2>/dev/null); do
        exe="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
        exe="${exe% (deleted)}"      # the binary was replaced on disk under it
        if [ "$exe" = "$want" ]; then echo "$pid"; return 0; fi
    done
    return 1
}
_health_gate() {
    appj="$CURRENT/app.json"
    wait_s="$(_gate_timing "${THEIA_OTA_HEALTH_WAIT_S:-}" "$appj" wait_s 60 "$_GATE_CAP_WAIT")"
    stable_s="$(_gate_timing "${THEIA_OTA_APP_STABLE_S:-}" "$appj" stable_s 10 "$_GATE_CAP_STABLE")"
    hook_s="$(_gate_timing "${THEIA_OTA_HOOK_TIMEOUT_S:-}" "$appj" hook_timeout_s 10 "$_GATE_CAP_HOOK")"
    need="${THEIA_OTA_HEALTH_STABLE:-3}"
    case "$need"   in ''|*[!0-9]*|0) need=3 ;; esac
    [ "$hook_s" -gt 0 ] 2>/dev/null || hook_s=10
    if [ "$wait_s" -eq 0 ]; then
        echo "theia-swp: WARNING — commit health gate DISABLED (THEIA_OTA_HEALTH_WAIT_S=0): no supervisor, app-process or hook check" >&2
        return 0
    fi
    echo "theia-swp: commit gate: wait ${wait_s}s, app stable ${stable_s}s, hook timeout ${hook_s}s"
    t=0; streak=0; last=""
    while :; do
        pid=""
        [ -f "$CURRENT/config/executor.json" ] && pid="$(_supervisor_pid || true)"
        if [ -n "$pid" ] && [ "$pid" = "$last" ]; then streak=$((streak + 1))
        elif [ -n "$pid" ]; then streak=1
        else streak=0; fi
        last="$pid"
        if [ "$streak" -ge "$need" ]; then
            echo "theia-swp: health OK — supervisor pid $pid stable on $(readlink "$CURRENT" 2>/dev/null) after ${t}s"
            break
        fi
        if [ "$t" -ge "$wait_s" ]; then
            echo "theia-swp: COMMIT FAILED — no healthy supervisor ($THEIA_ROOT/bin/supervisor) on $(readlink "$CURRENT" 2>/dev/null || echo none) within ${wait_s}s — Mender will roll back" >&2
            return 1
        fi
        sleep 1; t=$((t + 1))
    done
    rel="$(readlink -f "$CURRENT")"
    plist="$(_swp_processes "$appj")" || {
        echo "theia-swp: COMMIT FAILED — invalid process list in $appj — Mender will roll back" >&2
        return 1; }
    if [ -z "$plist" ]; then
        echo "theia-swp: WARNING — the SWP declares no processes (no app.json processes[]): commit gate checks the supervisor only" >&2
    else
        _app_gate "$rel" "$plist" "$t" "$wait_s" "$stable_s" || return 1
    fi
    _run_health_hook "$rel" "$hook_s" || return 1
    echo "theia-swp: health OK — $(readlink "$CURRENT" 2>/dev/null)"
    return 0
}

# ---- prune stale SWP releases (mirrors UCM's prune_releases) -----------------
# Standalone Mender installs (no UCM driving the lifecycle) otherwise pile up old
# releases/<swp>-<ver> forever — the "tangled symlinks" a rig accrues. Keep the
# newest N (default 3, THEIA_SWP_RETAIN) and NEVER touch:
#   * current / previous (the live + rollback targets),
#   * any runtime-* release — the services BASE the anchored symlink + every SWP
#     overlay depend on (removing it bricks the rig).
# UCM's own prune (services/ucm/impl/release_dir.hpp) covers the fleet path; this
# is the standalone-path equivalent, oldest-first by mtime.
_prune_releases() {
    keep="${THEIA_SWP_RETAIN:-3}"
    reldir="$THEIA_ROOT/releases"
    [ -d "$reldir" ] || return 0
    cur="$(readlink -f "$CURRENT" 2>/dev/null || true)"
    prev="$(readlink -f "$PREVIOUS" 2>/dev/null || true)"
    # Candidates = real release dirs, EXCLUDING runtime-* and the current/previous
    # targets, oldest-first. `ls -dt` is newest-first; tail past `keep` = the old.
    set --
    for d in $(ls -dt "$reldir"/*/ 2>/dev/null); do
        d="${d%/}"
        case "$(basename "$d")" in runtime-*) continue ;; esac   # never the base
        [ -L "$d" ] && continue                                  # skip symlinks (e.g. runtime anchor)
        rp="$(readlink -f "$d" 2>/dev/null || echo "$d")"
        [ "$rp" = "$cur" ] && continue
        [ "$rp" = "$prev" ] && continue
        set -- "$@" "$d"
    done
    # $@ is the prunable set, newest-first; drop the first `keep`, remove the rest.
    i=0
    for d in "$@"; do
        i=$((i + 1))
        [ "$i" -le "$keep" ] && continue
        rm -rf "$d" && echo "theia-swp: pruned old release $(basename "$d")"
    done
}

# ---- the flip: stage the SWP as a real release + atomically re-aim current ----
_stage_and_flip() {
    ver="$1"; work="$2"
    # The base release providing the services bin: whatever current resolves to
    # (runtime-<ver> at rest, or a prior SWP — either carries services bin).
    base_rel_dir="$(cd "$THEIA_ROOT" && readlink -f "$CURRENT")"
    [ -d "$base_rel_dir/bin" ] || {
        echo "theia-swp: current ($CURRENT) has no bin/ — runtime not staged?" >&2; return 1; }
    mdir="$(_swp_machine_dir "$work")"
    [ -n "$mdir" ] && [ -f "$work/$mdir/executor.json" ] || {
        echo "theia-swp: SWP has no manifest/<machine>/executor.json (machine=$MACHINE)" >&2; return 1; }

    # Snapshot the rollback target FIRST (the release running before this attempt).
    if [ -L "$CURRENT" ]; then
        ln -sfn "$(readlink "$CURRENT")" "$PREVIOUS"
    fi

    # Assemble releases/<ver>/{bin,lib,config}: services bin + SWP FC bin; the base
    # release's lib (theia-run sets LD_LIBRARY_PATH=current/lib, so the dir must
    # exist even when empty — services link system .so's + bundled libs from here);
    # SWP config.
    # Defence in depth for the rm -rf below (ArtifactInstall already checked both).
    _require_name "release name" "$ver" || return 1
    if _is_current "$ver"; then
        echo "theia-swp: REFUSED — '$ver' is the currently running release" >&2; return 1
    fi
    stage="$RELEASES/$ver"
    rm -rf "$stage"; mkdir -p "$stage/bin" "$stage/lib" "$stage/config"
    cp -a "$base_rel_dir/bin/." "$stage/bin/" 2>/dev/null || true       # services baseline
    [ -d "$base_rel_dir/lib" ] && cp -a "$base_rel_dir/lib/." "$stage/lib/" 2>/dev/null || true  # bundled libs
    [ -d "$work/bin" ] && cp -a "$work/bin/." "$stage/bin/" 2>/dev/null || true   # SWP FCs win
    [ -d "$work/lib" ] && cp -a "$work/lib/." "$stage/lib/" 2>/dev/null || true   # SWP libs (if any)
    cp -a "$work/$mdir/executor.json" "$stage/config/executor.json"     # the SHADOWING config
    for f in "$work/$mdir/"*.json; do                                   # per-FC config profiles
        [ -f "$f" ] || continue
        b="$(basename "$f")"; [ "$b" = executor.json ] && continue
        cp -a "$f" "$stage/config/$b"
    done
    [ -f "$work/manifest/machines.json" ] && cp -a "$work/manifest/machines.json" "$stage/config/machines.json"
    # The commit gate's inputs: app.json (the processes this SWP adds + optional
    # gate timings) and the optional `health` hook, at the release root.
    if [ -f "$work/app.json" ]; then
        cp "$work/app.json" "$stage/app.json"
        echo "theia-swp: app processes: $(_swp_processes "$stage/app.json" | cut -d' ' -f1 | tr '\n' ' ' | sed 's/ $//')"
    else
        echo "theia-swp: WARNING — SWP has no app.json (no declared processes): the commit gate will check the supervisor only" >&2
    fi
    if [ -f "$work/health" ]; then
        cp "$work/health" "$stage/health"; chmod 755 "$stage/health"
        echo "theia-swp: SWP health hook staged ($stage/health)"
    fi
    # NO key material from a package (hardening H): the rig serves mTLS from the
    # fleet PKI in /etc/theia/pki (key generated on the rig, pki-enroll). An SWP
    # that still carries a certs/ dir (an old or --allow-dev-certs build) is NOT
    # laid into config/certs — nothing on the rig reads config/certs any more.
    if [ -d "$work/$mdir/certs" ]; then
        echo "theia-swp: WARNING — payload carries $mdir/certs/ (dev certs); NOT installed (the rig uses /etc/theia/pki)" >&2
    fi
    echo "$ver" > "$stage/.mender_version"
    echo "theia-swp: staged SWP release $ver → $stage (services from $(basename "$base_rel_dir"))"

    # Non-root supervisor: this module runs as root (the Mender/UCM agent), so a
    # fresh release it lays is root-owned. When the rig adopted the theia:theia
    # model (deb postinst created the user + chowned /opt/theia), hand this new
    # release to theia too — else the non-root supervisor can't read the flipped
    # bin/config it's about to run. No-op on a root-run rig (no theia user).
    if getent passwd theia >/dev/null 2>&1; then
        chown -R theia:theia "$stage" 2>/dev/null || true
    fi

    # Atomic re-aim: temp symlink + rename(2) over current.
    tmp="$THEIA_ROOT/.current.$$"
    ln -sfn "releases/$ver" "$tmp"
    mv -T "$tmp" "$CURRENT"
    echo "theia-swp: current → releases/$ver (previous → $(readlink "$PREVIOUS" 2>/dev/null || echo none))"
}

# Allow sourcing for the helper functions (tests) without dispatching: a caller
# that sets THEIA_SWP_SOURCE_ONLY gets the functions defined but no state action.
[ -n "${THEIA_SWP_SOURCE_ONLY:-}" ] && return 0 2>/dev/null || true

case "$STATE" in
  Download)
    : ;;   # Mender auto-saves the payload to files/

  ArtifactInstall)
    art="$(_artifact_name)"
    [ "$art" != "unknown" ] || { echo "theia-swp: no version.txt" >&2; exit 1; }

    # Snapshot the rollback target BEFORE the first refusal point: Mender runs
    # ArtifactRollback after a failed ArtifactInstall, and a stale `previous`
    # would then drop the board to the release-before-last. (_stage_and_flip
    # repeats the same snapshot; it is idempotent.)
    if [ -L "$CURRENT" ]; then
        ln -sfn "$(readlink "$CURRENT")" "$PREVIOUS"
    fi
    # version.txt is untrusted and becomes releases/<art> (which _stage_and_flip
    # rm -rf's): one safe path component only, and never the RUNNING release.
    _require_name "release name (version.txt)" "$art" || exit 1
    if _is_current "$art"; then
        echo "theia-swp: REFUSED — '$art' is the currently running release (re-install would delete the live tree)" >&2
        exit 1
    fi

    tarball="$(ls "$FILES"/files/*.tar.* 2>/dev/null | head -1 || true)"
    [ -n "$tarball" ] || tarball="$(ls "$FILES"/*.tar.* 2>/dev/null | head -1 || true)"
    [ -n "$tarball" ] || { echo "theia-swp: no SWP tarball in payload" >&2; exit 1; }
    work="$(mktemp -d)"
    _tar_extract "$tarball" "$work" || { rm -rf "$work"; exit 1; }
    # app.json process names/exes become paths the gate probes: validate up front.
    _swp_processes "$work/app.json" >/dev/null || {
        echo "theia-swp: REFUSED — invalid app.json process list" >&2; rm -rf "$work"; exit 1; }

    # runtime precondition (deploy sequencing).
    req_rt="$(_payload requires_runtime.txt)"
    pin=""; [ -n "$req_rt" ] && pin="$(tr -d '[:space:]' < "$req_rt")"
    _require_runtime "$pin" || { rm -rf "$work"; exit 1; }

    # MAJOR migration (against the still-current release), then stage + flip.
    _run_migration "$work" || { rm -rf "$work"; exit 1; }
    _stage_and_flip "$art" "$work" || { rm -rf "$work"; exit 1; }
    # Lazy resources: fetch the SWP's declared models into the flipped release
    # (before ArtifactCommit restarts the supervisor). $work still holds models.json.
    _pull_models "$work"
    rm -rf "$work"
    echo "theia-swp: installed SWP release '$art'"
    ;;

  ArtifactCommit)
    # The flip happened in ArtifactInstall; restart the supervisor so it adopts
    # current/config (the SWP's executor). Standalone this is the activation.
    _reload_supervisor
    # Health gate: a non-zero exit here makes Mender run ArtifactRollback.
    _health_gate || exit 1
    echo "theia-swp: committed current=$(readlink "$CURRENT" 2>/dev/null)"
    ;;

  ArtifactRollback)
    if [ -L "$PREVIOUS" ]; then
        prev="$(readlink "$PREVIOUS")"
        tmp="$THEIA_ROOT/.current.$$"
        ln -sfn "$prev" "$tmp"
        mv -T "$tmp" "$CURRENT"
        echo "theia-swp: ROLLBACK current → $prev"
        _reload_supervisor
    else
        # Nothing to restore: fail loudly, so Mender records the rollback as
        # failed instead of reporting a clean rollback that never ran.
        echo "theia-swp: ROLLBACK FAILED — no previous release to roll back to (current=$(readlink "$CURRENT" 2>/dev/null || echo none))" >&2
        exit 1
    fi
    ;;

  SupportsRollback)   echo "Yes" ;;
  NeedsArtifactReboot) echo "No" ;;

  Cleanup)
    rm -f "$THEIA_ROOT"/.current.* 2>/dev/null || true
    # Prune stale releases so standalone Mender installs don't accrete forever
    # (the tangled-symlink cleanup, made permanent). Best-effort — never fail the
    # deploy over housekeeping.
    _prune_releases || true
    ;;

  *) exit 0 ;;
esac
