# HAND-OWNED. rds tests.
#
# Live zero-copy roundtrip over RouDi (the iceoryx broker must be running). A
# cc_binary (not a sandboxed cc_test — it needs the live RouDi + shared memory);
# the robot suite runs it, skipping cleanly if RouDi is down.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "rds_roundtrip",
    srcs = ["rds_roundtrip.cc"],
    copts = ["-std=c++17", "-fPIC"],
    deps = ["//services/rds/transport:rds"],
)

# The isolated-stack naming rule (no RouDi needed).
cc_test(
    name = "test_stack_qualified",
    srcs = ["test_stack_qualified.cc"],
    copts = ["-std=c++17", "-fPIC"],
    deps = ["//services/rds/transport:rds"],
)

# The RDS path's own latency (Loan -> Take) for N streams written at once and polled
# by one reader in another process; needs the host RouDi. docs/HOST-PASCAL.md.
cc_binary(
    name = "rds_latency_bench",
    srcs = ["rds_latency_bench.cc"],
    copts = ["-std=c++17", "-fPIC", "-O2"],
    deps = ["//services/rds/transport:rds"],
)
