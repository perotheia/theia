package system.services.rdsdemo

// Two compositions = two processes (a producer process, a consumer process),
// each registering with RouDi under its own runtime name.
// RdsProducer prototypes ONE writer node twice: each prototype publishes on its
// own stream, keyed on its runtime (prototype) name: /Cam_left/frames and
// /Cam_right/frames.
composition RdsProducer {
    prototype FrameProducer cam_left
    prototype FrameProducer cam_right
}
composition RdsConsumer { prototype FrameConsumer frame_consumer }
